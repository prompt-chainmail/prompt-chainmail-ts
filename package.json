{
  "name": "prompt-chainmail",
  "version": "0.7.0",
  "description": "Security middleware that shields AI applications from prompt injection, jailbreaking, and obfuscated attacks through composable defense layers.",
  "type": "module",
  "main": "./dist/prompt-chainmail.cjs",
  "module": "./dist/prompt-chainmail.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/prompt-chainmail.es.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/prompt-chainmail.cjs"
      }
    }
  },
  "files": [
    "dist",
    "DISCLOSURE"
  ],
  "contentPolicy": {
    "class": "dual-use"
  },
  "scripts": {
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:ci": "vitest run",
    "benchmark": "vitest bench --config vitest.bench.config.ts --run",
    "benchmark:ci": "vitest bench --config vitest.bench.config.ts --run --outputJson bench/.last-run.json && node scripts/compare-benchmarks.mjs bench/baselines/rivets.json bench/.last-run.json",
    "benchmark:baseline": "vitest bench --config vitest.bench.config.ts --run --outputJson bench/baselines/rivets.json && node scripts/stamp-benchmark-baseline.mjs bench/baselines/rivets.json local",
    "benchmark:baseline:ci": "vitest bench --config vitest.bench.config.ts --run --outputJson bench/baselines/rivets.json && node scripts/stamp-benchmark-baseline.mjs bench/baselines/rivets.json ubuntu-latest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "security": "semgrep --config=.semgrep.yml src/",
    "fetch:classifier": "node scripts/fetch-classifier-model.mjs",
    "generate:classifier": "npm run fetch:classifier",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run test:ci",
    "publish:npm": "npm stage publish --access public --provenance=false",
    "publish:npm:list": "npm stage list prompt-chainmail",
    "publish:jsr": "npx jsr publish",
    "publish:all": "npm run publish:npm && npm run publish:jsr"
  },
  "keywords": [
    "prompt-injection",
    "security",
    "middleware",
    "chainmail",
    "ai-security",
    "llm-protection",
    "pipeline",
    "rivets",
    "typescript"
  ],
  "author": "prompt-chainmail <alexandrughinea.dev+prompt-chainmail@gmail.com>",
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prompt-chainmail/prompt-chainmail-ts.git"
  },
  "bugs": {
    "url": "https://github.com/prompt-chainmail/prompt-chainmail-ts/issues"
  },
  "homepage": "https://github.com/prompt-chainmail/prompt-chainmail-ts#readme",
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2",
    "vite": "8.0.16",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "franc": "^6.2.0",
    "onnxruntime-web": "^1.27.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
